{
  "name": "zennx-downloader",
  "version": "1.8.67",
  "description": "Zennx Downloader — Universal, Zero-Cloud, Client-Side Media Downloader for Android, Windows, and CLI.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/elskyx/Zennx-Downloader.git"
  },
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "build:scrapers": "node scripts/compile-scrapers.mjs",
    "build:icons": "python scripts/generate-all-installer-logos.py",
    "serve": "npx serve public -l 3000",
    "cli": "node cli/index.js",
    "android:sync": "npm run build:scrapers && npx cap sync android",
    "android:dev": "npm run android:sync && npx cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "windows:dev": "npm run build:scrapers && npx tauri dev",
    "windows:build": "npm run build:scrapers && npx tauri build --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@coflyn/scrapr": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.0",
    "typescript": "^7.0.2"
  }
}
